{
  "info": {
    "_postman_id": "9f3c1c2e-7a4b-4e6d-8c1f-2d3e4f5a6b7c",
    "name": "KantinFlow SIM - Login dan Penerimaan Stok",
    "description": "Urutan: (1) Login petugas untuk menyimpan token, (2) Terima 5 kotak Susu Kotak, (3) Tolak jumlah 0. Sebelum mulai, jalankan npm.cmd run seed:reset lalu salin itemId dari keluaran seed ke variabel koleksi itemId. Contoh mengasumsikan saldo awal 0.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login petugas",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Token disimpan ke variabel koleksi', () => {",
              "  pm.expect(body.data.token).to.be.a('string').and.not.empty;",
              "  pm.collectionVariables.set('token', body.data.token);",
              "});",
              "pm.test('Profil minimal tanpa hash password', () => {",
              "  pm.expect(body.data.user).to.not.have.property('passwordHash');",
              "  pm.expect(body.data.user).to.have.all.keys('id', 'name', 'email', 'role');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "description": "Isi variabel password terlebih dahulu. Token hasil login otomatis masuk ke variabel token."
      }
    },
    {
      "name": "2. Terima 5 kotak Susu Kotak",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('Diterima 201 atau replay idempoten 200', () => {",
              "  pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "pm.test('Saldo menjadi 5 kotak', () => {",
              "  pm.expect(body.data.stockBalance).to.eql('5');",
              "  pm.expect(body.data.unit).to.eql('kotak');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "demo-receipt-5-kotak"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"itemId\": \"{{itemId}}\",\n  \"batchCode\": \"SUSU-DEMO-01\",\n  \"quantity\": \"5\",\n  \"unitCost\": \"4500.00\",\n  \"receivedOn\": \"2026-11-17\",\n  \"expiresOn\": \"2026-11-24\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/stock/receipts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "stock",
            "receipts"
          ]
        },
        "description": "Memakai token dari request login. Idempotency-Key tetap agar pengiriman ulang tidak menggandakan stok."
      }
    },
    {
      "name": "3. Tolak jumlah 0",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('Ditolak 400', () => pm.response.to.have.status(400));",
              "pm.test('Kode validasi dan alasan jumlah', () => {",
              "  pm.expect(body.error.code).to.eql('VALIDATION_ERROR');",
              "  pm.expect(body.error.fields.quantity).to.eql('Jumlah harus lebih dari 0');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "demo-receipt-zero"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"itemId\": \"{{itemId}}\",\n  \"batchCode\": \"SUSU-DEMO-02\",\n  \"quantity\": \"0\",\n  \"unitCost\": \"4500.00\",\n  \"receivedOn\": \"2026-11-17\",\n  \"expiresOn\": \"2026-11-24\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/stock/receipts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "stock",
            "receipts"
          ]
        },
        "description": "Validasi berjalan sebelum transaksi, sehingga tidak ada batch atau riwayat baru dan saldo tetap 5."
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "email",
      "value": "petugas@kantinflow.local"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "itemId",
      "value": ""
    }
  ]
}
