# Salin file ini menjadi .env lalu isi nilainya.
# .env tidak ikut ter-commit.

# Port server HTTP (Render mengisi PORT secara otomatis; default lokal 3000, sesuai proxy Vite).
PORT=3000

# Koneksi MongoDB (lokal replica set atau MongoDB Atlas mongodb+srv://...).
# Contoh MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kantinflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/kantinflow_dev?replicaSet=rs0
MONGODB_DB=kantinflow_dev

# Rahasia JWT minimal 32 byte. Buat nilai acak sendiri, jangan pakai contoh ini.
JWT_SECRET=ganti-dengan-rahasia-acak-minimal-32-byte
JWT_EXPIRES_IN=8h

# Daftar origin frontend yang diizinkan CORS, dipisahkan koma.
# Contoh produksi: https://kantinflow-sim.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Dipakai npm test. Tes membuat database acak berawalan kantinflow_test_.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0

# Data demo lokal yang dibuat oleh npm run seed.
DEMO_ADMIN_EMAIL=admin@kantinflow.local
DEMO_ADMIN_PASSWORD=isi-password-admin-lokal
DEMO_ADMIN_NAME=Admin Kantin

DEMO_PETUGAS_EMAIL=petugas@kantinflow.local
DEMO_PETUGAS_PASSWORD=isi-password-petugas-lokal
DEMO_PETUGAS_NAME=Petugas Demo
