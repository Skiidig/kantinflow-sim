            "body": {
              "mode": "raw",
              "raw": "{\n  \"batchId\": \"{{batchId}}\",\n  \"quantity\": \"1\",\n  \"reason\": \"Kemasan rusak / bocor\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/stock/disposals",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stock", "disposals"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Monitoring, History & Reports (FR-004, FR-005, FR-007)",
      "item": [
        {
          "name": "Dashboard Pemantauan (Low Stock, H-3, Kedaluwarsa)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/dashboard?days=3",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "dashboard"],
              "query": [
                { "key": "days", "value": "3" }
              ]
            }
          }
        },
        {
          "name": "Riwayat Transaksi Stok (Filter & Pagination)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Laporan Biaya Barang Terbuang (Admin Only — Petugas 403)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reports/disposals",
