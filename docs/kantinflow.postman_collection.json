{
  "info": {
    "_postman_id": "a6f7e82d-4c8d-4d6e-9c52-8d93c4f1e201",
    "name": "KantinFlow SIM API v1 (FR-001 s.d. FR-007)",
    "description": "Koleksi Postman lengkap untuk menguji seluruh endpoint REST API KantinFlow SIM (/api/v1): Autentikasi JWT, Manajemen Akun Petugas, Manajemen Barang & Batch, Dashboard H-3, Penerimaan Stok Idempoten, Pemakaian FEFO Atomik, Pembuangan Stok, Riwayat Transaksi, dan Laporan Biaya Admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@kantinflow.local",
      "type": "string"
    },
    {
      "key": "petugasEmail",
      "value": "petugas@kantinflow.local",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "petugasToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "itemId",
      "value": "",
      "type": "string"
    },
    {
      "key": "batchId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth & Users (FR-001)",
      "item": [
        {
          "name": "Login Admin (Simpan {{token}} & {{adminToken}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "if (json?.data?.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "  pm.collectionVariables.set('adminToken', json.data.token);",
                  "}",
                  "pm.test('Token & role admin diterima', function () {",
                  "  pm.expect(json.data.token).to.be.a('string');",
                  "  pm.expect(json.data.user.role).to.eql('admin');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Login Petugas (Simpan {{token}} & {{petugasToken}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "if (json?.data?.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "  pm.collectionVariables.set('petugasToken', json.data.token);",
                  "}",
                  "pm.test('Role petugas diterima tanpa passwordHash', function () {",
                  "  pm.expect(json.data.user.role).to.eql('petugas');",
                  "  pm.expect(json.data.user).to.not.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{petugasEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Buat Akun Petugas Baru (Admin Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "if (json?.data?.id) pm.collectionVariables.set('userId', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Siti Rahayu\",\n  \"email\": \"siti.petugas@kantinflow.local\",\n  \"password\": \"PetugasDemo123!\",\n  \"role\": \"petugas\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"]
            }
          }
        },
        {
          "name": "Daftar Akun Pengguna (Admin Only)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users?role=petugas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"],
              "query": [
                { "key": "role", "value": "petugas" }
              ]
            }
          }
        },
        {
          "name": "Ubah Status Aktif Akun (Admin Only)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Items & Batches (FR-002 & FR-003)",
      "item": [
        {
          "name": "Tambah Barang Baru (Admin Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "if (json?.data?.id) pm.collectionVariables.set('itemId', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"ROTI-TAWAR\",\n  \"name\": \"Roti Tawar Gandum\",\n  \"baseUnit\": \"bungkus\",\n  \"minimumStock\": \"5\",\n  \"quantityScale\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "items"]
            }
          }
        },
        {
          "name": "Daftar Barang (Search, Filter, Sort, Pagination)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "if (!pm.collectionVariables.get('itemId') && json?.data?.[0]?.id) {",
                  "  pm.collectionVariables.set('itemId', json.data[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/items?q=&status=active&sortBy=name&sortOrder=asc&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "items"],
              "query": [
                { "key": "q", "value": "" },
                { "key": "status", "value": "active" },
                { "key": "sortBy", "value": "name" },
                { "key": "sortOrder", "value": "asc" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Detail Satu Barang",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/items/{{itemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "items", "{{itemId}}"]
            }
          }
        },
        {
          "name": "Ubah Data Barang (Admin Only)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Roti Tawar Gandum Spesial\",\n  \"minimumStock\": \"6\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/items/{{itemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "items", "{{itemId}}"]
            }
          }
        },
        {
          "name": "Daftar Batch per Barang (Urut FEFO)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/items/{{itemId}}/batches?onlyRemaining=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "items", "{{itemId}}", "batches"],
              "query": [
                { "key": "onlyRemaining", "value": "false" }
              ]
            }
          }
        },
        {
          "name": "Hapus (204) atau Arsipkan (200) Barang (Admin Only)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/items/{{itemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "items", "{{itemId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Stock Operations (FR-005, FR-006, FR-007)",
      "item": [
        {
          "name": "Terima Stok Batch A (5 unit, H+2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created atau 200 Replay', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "const json = pm.response.json();",
                  "if (json?.data?.batchId) pm.collectionVariables.set('batchId', json.data.batchId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Idempotency-Key", "value": "demo-receipt-batch-a-001" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"{{itemId}}\",\n  \"batchCode\": \"BATCH-DEMO-A\",\n  \"quantity\": \"5\",\n  \"unitCost\": \"4500.00\",\n  \"receivedOn\": \"2026-11-21\",\n  \"expiresOn\": \"2026-11-23\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/stock/receipts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stock", "receipts"]
            }
          }
        },
        {
          "name": "Terima Stok Batch B (7 unit, H+10)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created atau 200 Replay', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "const json = pm.response.json();",
                  "if (json?.data?.batchId) pm.collectionVariables.set('batchId', json.data.batchId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Idempotency-Key", "value": "demo-receipt-batch-b-001" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"{{itemId}}\",\n  \"batchCode\": \"BATCH-DEMO-B\",\n  \"quantity\": \"7\",\n  \"unitCost\": \"5000.00\",\n  \"receivedOn\": \"2026-11-21\",\n  \"expiresOn\": \"2026-12-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/stock/receipts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stock", "receipts"]
            }
          }
        },
        {
          "name": "Tolak Penerimaan Jumlah 0 (400 VALIDATION_ERROR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "pm.test('Kode error VALIDATION_ERROR', function () {",
                  "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Idempotency-Key", "value": "demo-receipt-zero-001" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"{{itemId}}\",\n  \"batchCode\": \"BATCH-ZERO\",\n  \"quantity\": \"0\",\n  \"unitCost\": \"4500.00\",\n  \"receivedOn\": \"2026-11-21\",\n  \"expiresOn\": \"2026-11-28\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/stock/receipts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stock", "receipts"]
            }
          }
        },
        {
          "name": "Pemakaian Stok FEFO Lintas Batch (8 unit)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Idempotency-Key", "value": "demo-usage-fefo-001" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"{{itemId}}\",\n  \"quantity\": \"8\",\n  \"note\": \"Pemakaian operasional kantin sesi pagi\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/stock/usages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stock", "usages"]
            }
          }
        },
        {
