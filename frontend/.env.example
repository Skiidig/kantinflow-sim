# Salin menjadi .env lalu sesuaikan itemId dengan keluaran `npm.cmd run seed:reset`
# di folder backend. Nilai itemId bukan rahasia, tetapi tetap lokal.
VITE_DEMO_ITEM_ID=isi-dengan-itemId-dari-seed
VITE_DEMO_ITEM_NAME=Susu Kotak
VITE_DEMO_ITEM_UNIT=kotak
VITE_DEMO_EMAIL=petugas@kantinflow.local

# Opsional. Kosongkan untuk memakai proxy Vite ke http://127.0.0.1:3000.
# Isi hanya bila frontend disajikan dari origin yang sama dengan backend/proxy;
# backend belum memasang CORS untuk pemanggilan lintas origin langsung.
# VITE_API_BASE_URL=http://127.0.0.1:3000
